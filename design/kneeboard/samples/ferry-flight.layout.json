{
  "schema": 1,
  "id": "ferry-flight",
  "name": "Ferry flight",
  "requires": [
    "flight",
    "route",
    "comms"
  ],
  "pages": [
    {
      "id": "card",
      "label": "CARD",
      "layout": "single",
      "blocks": [
        {
          "type": "fields",
          "band": "header",
          "items": [
            {
              "label": "CALLSIGN",
              "value": "{flight.callsign}",
              "width": "sm"
            },
            {
              "label": "AIRCRAFT",
              "value": "{flight.aircraft}",
              "width": "sm"
            },
            {
              "label": "FUEL",
              "value": "{flight.fuel}",
              "width": "xs",
              "style": "mono"
            },
            {
              "label": "ROUTE",
              "value": "{flight.from} → {flight.to}",
              "width": "flex",
              "emphasis": "strong"
            }
          ]
        },
        {
          "type": "steps",
          "title": "LEGS",
          "repeat": "route.legs",
          "complete": "done",
          "row": {
            "name": "{name}",
            "ref": "{ref|blank}",
            "gate": "{alt} / {speed}",
            "note": "{note|blank}",
            "state": "{state|none}"
          }
        },
        {
          "type": "table",
          "band": "comms",
          "column": 1,
          "title": "RADIO",
          "repeat": "comms.stations",
          "columns": [
            {
              "value": "{name}",
              "width": "md",
              "emphasis": "strong"
            },
            {
              "value": "{freq}",
              "width": "sm",
              "style": "mono"
            },
            {
              "value": "{tacan|dash}",
              "width": "xs",
              "style": "mono",
              "emphasis": "muted"
            }
          ]
        },
        {
          "type": "table",
          "band": "comms",
          "column": 2,
          "title": "ALTERNATES",
          "when": "route.alternates",
          "repeat": "route.alternates",
          "columns": [
            {
              "value": "{name}",
              "width": "md",
              "emphasis": "strong"
            },
            {
              "value": "{rwy}",
              "width": "xs",
              "style": "mono"
            },
            {
              "value": "{dist}",
              "width": "flex",
              "style": "mono"
            }
          ]
        },
        {
          "type": "prose",
          "title": "NOTES",
          "bind": "route",
          "badge": "{bingo|blank}",
          "list": "notes"
        }
      ]
    }
  ]
}
