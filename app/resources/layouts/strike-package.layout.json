{
  "schema": 1,
  "id": "strike-package",
  "name": "Strike package",
  "requires": [
    "flight",
    "threats",
    "route",
    "comms"
  ],
  "pages": [
    {
      "id": "card",
      "label": "CARD",
      "layout": "single",
      "blocks": [
        {
          "type": "fields",
          "band": "header",
          "items": [
            {
              "label": "CALLSIGN",
              "value": "{flight.callsign}",
              "width": "sm"
            },
            {
              "label": "BULLSEYE",
              "value": "{flight.bullseye}",
              "width": "md",
              "style": "mono"
            },
            {
              "label": "S-A THREAT",
              "value": "{threats.surface}",
              "width": "md",
              "emphasis": "threat"
            },
            {
              "label": "A-A THREAT",
              "value": "{threats.air}",
              "width": "flex",
              "emphasis": "threat"
            }
          ]
        },
        {
          "type": "stations",
          "band": "header",
          "title": "LOADOUT",
          "when": "flight.stations",
          "repeat": "flight.stations",
          "wrap": 9,
          "cell": {
            "value": "{load}",
            "label": "{station}",
            "state": "{kind|none}"
          }
        },
        {
          "type": "steps",
          "title": "ROUTE",
          "repeat": "route.steps",
          "complete": "done",
          "row": {
            "name": "{name}",
            "ref": "{ref}",
            "gate": "{alt} / {speed}",
            "note": "{note|blank}",
            "state": "{state|none}"
          }
        },
        {
          "type": "table",
          "title": "TARGETS",
          "when": "route.targets",
          "repeat": "route.targets",
          "columns": [
            {
              "value": "{name}",
              "width": "sm",
              "emphasis": "strong"
            },
            {
              "value": "{wp}",
              "width": "xs",
              "style": "mono"
            },
            {
              "value": "{coord|dash}",
              "width": "md",
              "style": "mono"
            },
            {
              "value": "{desc}",
              "width": "flex"
            },
            {
              "value": "{weapon|dash}",
              "width": "sm",
              "emphasis": "muted"
            },
            {
              "value": "{laser|dash}",
              "width": "xs",
              "style": "mono",
              "emphasis": "strong"
            }
          ]
        },
        {
          "type": "table",
          "band": "comms",
          "column": 1,
          "title": "COMM 1",
          "repeat": "comms.primary",
          "columns": [
            {
              "value": "{ch}",
              "width": "badge",
              "style": "mono"
            },
            {
              "value": "{name}",
              "width": "flex",
              "emphasis": "strong"
            },
            {
              "value": "{freq}",
              "width": "sm",
              "style": "mono"
            },
            {
              "value": "{tacan|dash}",
              "width": "xs",
              "style": "mono",
              "emphasis": "muted"
            }
          ]
        },
        {
          "type": "table",
          "band": "comms",
          "column": 2,
          "title": "MIDS",
          "when": "comms.mids",
          "repeat": "comms.mids",
          "columns": [
            {
              "value": "{name}",
              "width": "flex",
              "emphasis": "strong"
            },
            {
              "value": "{channel}",
              "width": "xs",
              "style": "mono"
            }
          ]
        },
        {
          "type": "table",
          "band": "comms",
          "column": 3,
          "title": "TANKER · DIVERT",
          "repeat": "comms.fields",
          "mark": "next",
          "columns": [
            {
              "value": "{name}",
              "width": "md",
              "emphasis": "strong"
            },
            {
              "value": "{tacan|dash}",
              "width": "xs",
              "style": "mono"
            },
            {
              "value": "{alt|dash}",
              "width": "flex",
              "style": "mono"
            },
            {
              "value": "{hdg|dash}",
              "width": "sm",
              "style": "mono"
            },
            {
              "value": "{time|blank}",
              "width": "sm",
              "style": "mono",
              "emphasis": "strong"
            }
          ]
        },
        {
          "type": "prose",
          "title": "GAME PLAN",
          "bind": "plan",
          "badge": "{bingo}",
          "list": "flow"
        }
      ]
    },
    {
      "id": "map",
      "label": "MAP",
      "layout": "full-bleed",
      "when": "map",
      "blocks": [
        {
          "type": "image",
          "bind": "map",
          "source": "{blob}",
          "caption": "{caption|blank}"
        }
      ]
    }
  ]
}
