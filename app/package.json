{
  "name": "taclink",
  "version": "0.8.1",
  "private": true,
  "description": "Tac Link — EFB for DCS with shared tactical intel and live briefing",
  "main": "src/main/index.js",
  "author": "flyinggab",
  "repository": "https://github.com/flyinggab/intel-broadcast",
  "scripts": {
    "start": "electron .",
    "relay:standalone": "node src/main/relayServer.js",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "dependencies": {
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "allowScripts": {
    "electron@32.3.3": true,
    "uiohook-napi@1.5.5": true
  },
  "build": {
    "appId": "com.flyinggab.taclink",
    "productName": "Tac Link",
    "files": [
      "src/**/*",
      "resources/config.default.json",
      "photos/**/*",
      "package.json"
    ],
    "icon": "build/icon.png",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "files": [
        "!node_modules/uiohook-napi/**"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "flyinggab",
      "repo": "intel-broadcast",
      "releaseType": "release"
    },
    "npmRebuild": false,
    "asarUnpack": [
      "**/node_modules/uiohook-napi/**"
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tac Link",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      }
    ]
  },
  "optionalDependencies": {
    "uiohook-napi": "^1.5.5"
  },
  "license": "GPL-3.0-or-later"
}
