{
  "name": "intel-broadcast",
  "version": "0.5.1",
  "private": true,
  "description": "DCS intel photo broadcast companion app (viewer + GM relay)",
  "main": "src/main/index.js",
  "author": "flyinggab",
  "repository": "https://github.com/flyinggab/intel-broadcast",
  "scripts": {
    "start": "electron .",
    "relay:standalone": "node src/main/relayServer.js",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "dependencies": {
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "allowScripts": {
    "electron@32.3.3": true
  },
  "build": {
    "appId": "com.flyinggab.intel-broadcast",
    "productName": "Intel Broadcast",
    "files": [
      "src/**/*",
      "resources/config.default.json",
      "photos/**/*",
      "package.json"
    ],
    "icon": "build/icon.png",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities"
    },
    "publish": {
      "provider": "github",
      "owner": "flyinggab",
      "repo": "intel-broadcast",
      "releaseType": "release"
    }
  }
}
